flowchart TD
  classDef race fill:#fde2e4,stroke:#c0392b,color:#000
  classDef scan fill:#dbeafe,stroke:#1d4ed8,color:#000
  classDef skip fill:#e5e7eb,stroke:#374151,color:#000
  classDef reap fill:#dcfce7,stroke:#15803d,color:#000
  classDef gate fill:#fef3c7,stroke:#b45309,color:#000

  subgraph race["The orphan"]
    r1["Pinned restore pod<br/>Unschedulable on source shortlist"]:::race
    r2["Restore interrupted<br/>(crash / abandoned request)"]:::race
    r3["Row settles away from restoring;<br/>execution retired or advanced"]:::race
    r4["Source frees capacity:<br/>stale pod binds → unrouted VM"]:::race
    r1 --> r2 --> r3 --> r4
  end

  tick["Tick (every 60s, if ENABLED)"]:::scan
  cache["Reflector cache:<br/>restore-annotated pods only"]:::scan
  filt{"terminating or<br/>missing uid / sandbox id / generation?"}:::gate
  classify["Batched Postgres classify<br/>ANY($1): lifecycle + active generation<br/>(excluding deleted tombstones)"]:::scan

  disp{"Supersession fence"}:::gate
  skipT["Skip: row restoring, other transient,<br/>quarantined, or unrecognized"]:::skip
  skipA["Skip: pod gen ≥ active gen<br/>(live runtime, re-drive adoptable,<br/>same-gen orphan → suspend subsystem),<br/>or no active execution outside suspended/failed"]:::skip
  orphan["Orphan: row deleted,<br/>suspended/failed with no active execution,<br/>or pod gen &lt; active gen"]:::reap

  clock{"continuously orphaned<br/>≥ threshold (5m)?<br/>(clock resets on cold cache / DB outage / restart)"}:::gate
  budget{"rate limit + tick budget<br/>(fairness cursor)"}:::gate
  verify["Verify: cache-bypassing pod GET<br/>(same UID, restore marker, sandbox, generation)<br/>+ authoritative Postgres recheck"]:::scan
  dry{"DRY_RUN?"}:::gate
  would["Metric mode:dry_run + log, once per pod<br/>no delete, no sandbox event"]:::skip
  del["cleanup_requested → DELETE<br/>preconditions: UID + resourceVersion<br/>no DB lock held<br/>→ requested_orphaned_restore_pod_delete"]:::reap
  pend{"later ticks: pod still<br/>in the cache?"}:::gate
  done["gone: reaped_orphaned_restore_pod<br/>+ cleanup_completed"]:::reap
  stuck["terminating ≥ 5m and confirmed by a fresh GET:<br/>teardown_stuck + cleanup_failed<br/>(re-read until it settles)"]:::race
  fail["error / timeout / 409:<br/>cleanup_failed, retry next tick"]:::skip

  r4 -.-> cache
  tick --> cache --> filt
  filt -->|no| classify --> disp
  disp --> skipT
  disp --> skipA
  disp --> orphan --> clock
  clock -->|yes| budget --> verify
  verify -->|still orphan| dry
  verify -->|not orphan / gone / changed| stop["Skip this tick"]:::skip
  dry -->|yes| would
  dry -->|no| del
  del -->|accepted| pend
  del -->|not accepted| fail
  pend -->|no| done
  pend -->|yes, too long| stuck
