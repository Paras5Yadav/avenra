# Postgres first; the avenra-db-migrate Job blocks on it.
k8s_yaml(helm_release("avenra", "infra/avenra/kind/charts/avenra-postgres"))
k8s_resource(
    "avenra-postgres",
    labels = ["data"],
    resource_deps = ["label-kind-infra"],
)

# API server.
# Per-sandbox pods need the shim wired into containerd before the first create
# lands, and the rate limiters' store should answer before the first create
# reaches them (they would admit it open, not fail it).
AVENRA_API_DEPS = ["avenra-postgres", "label-kind-workers", "label-kind-infra",
                  "install-avenra-shim", "internal-rpc-tls", "avenra-sandbox-network-policy",
                  "avenra-db-migrate", "avenra-redis"]
# No port_forward: localhost:8080 is the cluster's host port mapping onto the
# avenra-api-entry NodePort (kind-cluster.yaml.tmpl), which spreads connections
# across the autoscaled replicas as a deployment's load balancer does.
k8s_yaml(helm_release("avenra", "infra/avenra/kind/charts/avenra-api-local"))
k8s_resource(
    "avenra-api",
    labels = ["control-plane"],
    resource_deps = AVENRA_API_DEPS,
)
# The control-plane migrations, once, before any API replica starts (the
# chart's avenra-db-migrate Job), as a deployment runs them ahead of its
# application releases.
k8s_resource(
    "avenra-db-migrate",
    labels = ["data"],
    resource_deps = ["avenra-postgres", "label-kind-infra"],
)
# The dedicated admin API, its own process (--surface admin).
k8s_resource(
    "avenra-admin-api",
    labels = ["control-plane"],
    resource_deps = ["avenra-api"],
)

# The resource metrics API the API and data-plane HorizontalPodAutoscalers
# read, in kube-system as a managed cluster's add-on is.
k8s_yaml(helm("infra/avenra/kind/charts/avenra-metrics-server", name = "avenra", namespace = "kube-system"))
k8s_resource(
    "metrics-server",
    labels = ["control-plane"],
    resource_deps = ["label-kind-infra"],
)

# The Kind user stays locked in shared migrations. Provision only after the
# API pod finishes migrations; this also covers clusters brought up by Tilt
# without running the scripted bootstrap first.
local_resource(
    "provision-local-console",
    cmd = "AVENRA_KIND_CLUSTER={} bash infra/avenra/kind/scripts/provision-local-console.sh".format(KIND_CLUSTER),
    deps = ["infra/avenra/kind/scripts/provision-local-console.sh"],
    labels = ["bootstrap"],
    resource_deps = ["avenra-api"],
)

# Internal (cluster) API — node-ctl publishes node state here (this is node
# registration), template-manager resolves releases, and the seed publish
# registers the seed release against it.
k8s_yaml(helm(
    "infra/avenra/kind/charts/avenra-internal-api-local",
    name = "avenra",
    namespace = NAMESPACE,
    set = TELEMETRY_SET,
))
k8s_resource(
    "avenra-internal-api",
    labels = ["control-plane"],
    resource_deps = ["avenra-api", "provision-local-console", "label-kind-infra"],
)

# Control-plane credential-manager authority: owns the credential tables and
# the platform KEK; each node's credential-manager runs as its agent, and
# node-manager calls it for sandbox volume DEKs. It needs the API's migrations
# and the avenra_creds role the API's bootstrap provisions.
k8s_yaml(helm_release("avenra", "infra/avenra/kind/charts/avenra-credmgr-authority-local"))
k8s_resource(
    "avenra-credmgr-authority",
    labels = ["control-plane"],
    resource_deps = ["avenra-api", "label-kind-infra"],
)
# The authority's external key provider: the Kind-only intermediate-key broker
# fixture, whose derived keys survive restarts of either side.
k8s_yaml(helm("infra/avenra/kind/charts/avenra-kind-key-broker", name = "avenra", namespace = NAMESPACE))
k8s_resource(
    "avenra-kind-key-broker",
    labels = ["control-plane"],
    resource_deps = ["label-kind-infra"],
)

# Public data-plane service for native sessions and ECW wildcard hosts.
k8s_yaml(helm_release("avenra", "infra/avenra/kind/charts/avenra-data-plane-local"))
