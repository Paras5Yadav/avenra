# ── Object store + node services + seed publish ──────────────────────────────
#
# Versity S3 Gateway (versitygw, Apache-2.0; replaced SeaweedFS, which replaced
# MinIO) is a real S3-compatible object store on the infra node, serving its
# POSIX backend from a node-local hostPath. The bucket-init Job creates the
# `snapshots` + `templates` buckets through the S3 API. Both are public
# registry images the kind nodes pull directly, so no `kind load` step is
# needed.
k8s_yaml(helm_release("avenra", "infra/avenra/kind/charts/avenra-object-store"))
k8s_resource(
    "avenra-object-store",
    port_forwards = ["8333:8333"],  # S3 API
    labels = ["data"],
    resource_deps = ["label-kind-infra"],
)
k8s_resource(
    "avenra-object-store-bucket-init",
    labels = ["data"],
    resource_deps = ["avenra-object-store"],
)

# Redis: shared store for the two API rate limiters (cluster activation
# admission + per-client concurrency), which avenra-api, avenra-admin-api and
# avenra-cluster-controller reach through AVENRA_REDIS_URL. Public docker.io image
# pulled directly by the kind nodes (no `kind load`). avenra-api waits for it.
k8s_yaml(helm_release("avenra", "infra/avenra/kind/charts/avenra-redis-local"))
k8s_resource(
    "avenra-redis",
    labels = ["data"],
    resource_deps = ["label-kind-infra"],
)

# Node services: one release of each per role — `space` on the sandbox workers,
# `avenra-builder` (node.role=builder) on the builder nodes, which add
# build-manager — mirroring production's per-service DaemonSets. Each service
# tolerates peers that are not ready yet and restarts on its own, so nothing
# here orders them; they wait only for the node layer and the bootstrap
# resources their pods mount. A chart's values-builder.yaml carries its builder
# overrides.
# AVENRA_LOOP_DEVICE_TARGET sets the loop-device pool node-manager raises each
# node to once it is up; the node image stages the library's floor of 64 before
# that. Inherited from the environment so `AVENRA_LOOP_DEVICE_TARGET=128 tilt up`
# reaches the pod; unset renders nothing and the default applies.
LOOP_DEVICE_TARGET = os.getenv("AVENRA_LOOP_DEVICE_TARGET", "")
# The release list is shared with bootstrap.sh and the smoke bring-up.
NODE_RELEASES = str(local(["bash", "infra/avenra/kind/lib/node-services.sh", "releases"], quiet = True)).strip().split("\n")
watch_file("infra/avenra/kind/lib/node-services.sh")
watch_file("infra/avenra/kind/charts/avenra-node-service")
for line in NODE_RELEASES:
    release, role, service = line.split(" ")
    chart = "infra/avenra/kind/charts/avenra-{}-local".format(service)
    values = []
    if role == "builder" and os.path.exists(chart + "/values-builder.yaml"):
        values = [chart + "/values-builder.yaml"]
    node_set = TELEMETRY_SET + ["node.role={}".format(role)]
    if service == "node-manager" and LOOP_DEVICE_TARGET:
        node_set.append("loopDeviceTarget={}".format(LOOP_DEVICE_TARGET))
    k8s_yaml(helm(chart, name = release, namespace = NAMESPACE, values = values, set = node_set))
    k8s_resource(
        "{}-{}".format(release, service),
        labels = ["node-" + role],
        resource_deps = ["check-kind-node-image", "label-kind-workers", "sandbox-ssh-secret",
                         "internal-rpc-tls"],
    )

# Kind-only operator shell on every sandbox worker and builder; the smoke
# harness's on-node checks run here.
k8s_yaml(helm("infra/avenra/kind/charts/avenra-node-debug", name = "avenra", namespace = NAMESPACE))
k8s_resource(
    "avenra-node-debug",
    labels = ["node-debug"],
    resource_deps = ["check-kind-node-image", "label-kind-workers"],
)

# seed publish: uploads the locally built production seed to the object store and
# registers the release through the real ClusterApi RPCs. Workers then pull
# it via template-manager prefetch → volume-manager — the production path.
k8s_yaml(helm_release("avenra", "infra/avenra/kind/charts/avenra-seed-publish"))
k8s_resource(
    "avenra-seed-publish",
    labels = ["bootstrap"],
    resource_deps = ["avenra-internal-api", "avenra-object-store-bucket-init"],
)

# ── Superseded image prune ───────────────────────────────────────────────────
#
# Every build Tilt loads adds a `:tilt-<hash>` tag to each node's containerd
# store under $AVENRA_KIND_DATA_ROOT, which outlives the cluster. Whenever Tilt
# has nothing pending or in progress and what the cluster deploys has changed,
# this removes the builds of Avenra's own images that nothing deployed, built or
# running still names; third-party images are never touched. The rule and its
# safety are in prune-superseded-images.py and the Kind README.
# AVENRA_KIND_PRUNE_SUPERSEDED_IMAGES=0 leaves the resource out.
if os.getenv("AVENRA_KIND_PRUNE_SUPERSEDED_IMAGES", "1") != "0":
    local_resource(
        "prune-superseded-images",
        serve_cmd = ["python3", "infra/avenra/kind/scripts/prune-superseded-images.py",
                     "--cluster", KIND_CLUSTER, "--watch", "30",
                     "--tilt-resource", "prune-superseded-images"],
        deps = ["infra/avenra/kind/scripts/prune-superseded-images.py",
                "infra/avenra/kind/lib/avenra-images.sh"],
        labels = ["bootstrap"],
    )

# The host's Docker store, where those builds are made, keeps every one of them
# too: each Tilt build adds a `:tilt-build-<time>` tag (the $EXPECTED_REF the
# custom_build commands above tag) and Tilt's own `:tilt-<hash>`. Tilt's built-in
# pruner (docker_prune_settings) cannot remove them, labelled or not: it passes
# over every image with more than one tag (internal/engine/dockerprune/
# docker_pruner.go in tilt-dev/tilt). So whenever an update has settled, the
# same script removes from the host the builds of Avenra's images it would remove
# from the nodes, except that the build before the current one stays too.
# AVENRA_TILT_PRUNE_HOST_IMAGES=0 leaves the resource out.
if os.getenv("AVENRA_TILT_PRUNE_HOST_IMAGES", "1") != "0":
    local_resource(
        "prune-host-images",
        serve_cmd = ["python3", "infra/avenra/kind/scripts/prune-superseded-images.py",
                     "--host", "--cluster", KIND_CLUSTER, "--watch", "30",
                     "--tilt-resource", "prune-host-images"],
        deps = ["infra/avenra/kind/scripts/prune-superseded-images.py",
                "infra/avenra/kind/lib/avenra-images.sh"],
        labels = ["bootstrap"],
    )
