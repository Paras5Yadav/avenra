#!/usr/bin/env bash
set -euo pipefail

# Prefer a system-installed modprobe (e.g., from install-tools.py kmod).
for candidate in /sbin/modprobe /usr/sbin/modprobe /bin/modprobe /usr/bin/modprobe; do
    if [ -x "${candidate}" ]; then
        exec "${candidate}" "$@"
    fi
done

# Fall back to downloading kmod via apt into a local cache.
CACHE_DIR="${TMPDIR:-/tmp}/buildkite-kmod"

# Debian Bookworm puts kmod at /bin/kmod; other releases may use /usr/bin/kmod.
KMOD_BIN=""
for p in "${CACHE_DIR}/bin/kmod" "${CACHE_DIR}/usr/bin/kmod" "${CACHE_DIR}/sbin/kmod"; do
    if [ -x "$p" ]; then
        KMOD_BIN="$p"
        break
    fi
done

if [ -z "${KMOD_BIN}" ]; then
    workdir="$(mktemp -d)"
    trap 'rm -rf "${workdir}"' EXIT

    apt-get update -qq 2>/dev/null
    (
        cd "${workdir}"
        apt download kmod 2>/dev/null
        deb="$(printf '%s\n' kmod_*.deb)"
        dpkg-deb -x "${deb}" "${CACHE_DIR}"
    )

    # Locate the extracted binary.
    for p in "${CACHE_DIR}/bin/kmod" "${CACHE_DIR}/usr/bin/kmod" "${CACHE_DIR}/sbin/kmod"; do
        if [ -x "$p" ]; then
            KMOD_BIN="$p"
            break
        fi
    done

    if [ -z "${KMOD_BIN}" ]; then
        echo "modprobe shim: could not find kmod binary after extracting package" >&2
        echo "Contents of ${CACHE_DIR}:" >&2
        find "${CACHE_DIR}" -type f 2>/dev/null | head -20 >&2
        exit 1
    fi
fi

exec "${KMOD_BIN}" modprobe "$@"
