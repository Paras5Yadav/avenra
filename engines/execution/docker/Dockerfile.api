ARG AVENRA_RUST_BUILD_IMAGE=avenra-rust-build-api:local
FROM ${AVENRA_RUST_BUILD_IMAGE} AS rust-build

# uv's release image, pinned by its multi-platform index digest. uv's install
# script downloads from GitHub releases without retrying, and a reset connection
# either failed the build or, piped into sh, left the stage without uv. An image
# is a registry pull like the bases, which the Kind bring-up retries
# (infra/avenra/kind/scripts/pull-base-images.sh).
FROM ghcr.io/astral-sh/uv:0.9.9@sha256:f6e3549ed287fee0ddde2460a2a74a2d74366f84b04aaa34c1f19fec40da8652 AS uv

# The smoke suites' Python environment, resolved once here so the in-cluster
# smoke Job needs no package index at run time — a post-deploy gate must not be
# able to fail on a PyPI blip. The requirement list is derived from the suites'
# own PEP 723 headers and the avenra_smoke lock rather than written down, so a
# suite that changes a pin moves this environment with it.
FROM public.ecr.aws/docker/library/debian:bookworm-slim AS smoke-base

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      python3 \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/

FROM smoke-base AS smoke-requirements

WORKDIR /src
COPY pyproject.toml uv.lock ./
COPY avenra_smoke ./avenra_smoke
COPY scripts/tests ./scripts/tests
COPY scripts/avenra-cluster-smoke.py scripts/smoke-image-requirements.py ./scripts/

RUN uv export --frozen --no-hashes --no-emit-project --format requirements-txt \
      > /tmp/project-requirements.txt \
    && python3 scripts/smoke-image-requirements.py \
      --project-requirements /tmp/project-requirements.txt > /tmp/requirements.txt

# Installed from the derived list alone, so the environment's layer is keyed by
# the requirements rather than by every suite file: an edit that changes no pin
# reuses it from the build cache instead of downloading it again.
FROM smoke-base AS smoke-build

COPY --from=smoke-requirements /tmp/requirements.txt /tmp/requirements.txt
RUN python3 -m venv /avenra/smoke/venv \
    && /avenra/smoke/venv/bin/pip install \
      --no-cache-dir --disable-pip-version-check --require-virtualenv \
      -r /tmp/requirements.txt

# Everything before the image's own files, which the Kind build cache keeps
# (infra/avenra/kind/scripts/runtime-image-cache.sh).
FROM public.ecr.aws/docker/library/debian:bookworm-slim AS runtime-deps

RUN apt-get update && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      python3 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 952 avenra-api \
    && useradd --system --uid 952 --gid 952 --create-home --home-dir /space avenra-api

WORKDIR /space

FROM runtime-deps

LABEL org.opencontainers.image.title="avenra-api"
LABEL org.opencontainers.image.description="Deployable Avenra API image."

COPY --from=rust-build /artifacts/bin/avenra-api-svc /avenra/bin/avenra-api-svc
COPY --from=rust-build /artifacts/bin/avenra-db-migrator /avenra/bin/avenra-db-migrator
# Deploy-phase template bootstrap, alongside the migrator for the same reason:
# both are one-shot Jobs the deploy pipeline runs from this image rather than
# separate images, ECR repos, and build targets.
COPY --from=rust-build /artifacts/bin/avenra-template-publish /avenra/bin/avenra-template-publish
COPY --chmod=0755 scripts/avenra-db-migrate.sh /avenra/bin/avenra-db-migrate.sh
COPY --chmod=0755 scripts/avenra-db-bootstrap-roles.sh /avenra/bin/avenra-db-bootstrap-roles.sh
COPY --chmod=0755 scripts/avenra-db-provision.sh /avenra/bin/avenra-db-provision.sh

RUN chown -R avenra-api:avenra-api /space

# The in-cluster smoke Job, here for the same reason as the migrator and the
# template-publish binary: one-shot Jobs the deploy pipeline runs from this
# image rather than separate images, ECR repos, and build targets. The suites
# are copied unchanged — this image carries the runner, not a second copy of
# the scenarios.
#
# After the recursive chown, and owned at copy time: a `chown -R` over ~60 MB
# of virtualenv rewrites every one of those files into a new layer, doubling
# what the image costs to pull.
COPY --from=smoke-build --chown=avenra-api:avenra-api /avenra/smoke/venv /avenra/smoke/venv
COPY --chown=avenra-api:avenra-api pyproject.toml /avenra/smoke/suites/pyproject.toml
COPY --chown=avenra-api:avenra-api avenra_smoke /avenra/smoke/suites/avenra_smoke
COPY --chown=avenra-api:avenra-api scripts/tests /avenra/smoke/suites/scripts/tests
COPY --chown=avenra-api:avenra-api scripts/avenra-cluster-smoke.py /avenra/smoke/suites/scripts/avenra-cluster-smoke.py

ARG AVENRA_GIT_SHA=unknown
LABEL org.opencontainers.image.revision="${AVENRA_GIT_SHA}"
RUN mkdir -p /etc/space && printf '%s\n' "${AVENRA_GIT_SHA}" > /etc/avenra/build-git-sha

USER avenra-api

EXPOSE 8080
