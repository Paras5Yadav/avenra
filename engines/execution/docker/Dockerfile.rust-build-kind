      --bin avenra-sbxmgr \
      --bin avenra-nodectl \
      --bin avenra-sbxmgr-svc \
      --bin avenra-avenrad-host-svc \
      --bin avenra-netgtw-svc \
      --bin avenra-tmplmgr-svc \
