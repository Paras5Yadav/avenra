      --bin avenra-runtime-supervisor-svc \
      --bin avenra-rtmgr-svc \
      --bin avenra-rtmgr \
      --bin avenra-nodemgr-svc \
      --bin avenra-sbxmgr \
      --bin avenra-nodectl \
      --bin avenra-sbxmgr-svc \
      --bin avenra-avenrad-host-svc \
      --bin avenra-netgtw-svc \
      --bin avenra-tmplmgr-svc \
      --bin avenra-volmgr \
      --bin avenra-credmgr-svc \
      --bin avenra-volmgr-svc \
      --bin avenra-node-api-svc \
      --bin avenra-internal-api-svc \
      --bin avenra-nodectl-svc \
      --bin avenra-db-migrator \
      --bin avenra-api-svc \
      --bin avenra-template-publish \
      --bin avenra-data-plane-svc \
      --bin avenra-cluster-controller \
      --bin avenra-mock-branching-key-provider-svc

FROM cook AS build

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo/config.toml .cargo/config.toml
COPY crates ./crates
COPY proto ./proto
COPY db ./db
COPY infra/avenra/identity/node-identities.sh infra/avenra/identity/node-identities.sh
COPY templates/firecracker/seed/rootfs-builder.sh templates/firecracker/seed/rootfs-builder.sh
COPY templates/firecracker/recipes/seed.toml templates/firecracker/recipes/code-runtime.toml templates/firecracker/recipes/
COPY scripts/build-runtime-supervisor.sh scripts/build-runtime-supervisor.sh

RUN cargo build --locked --release \
      -F avenra-runtime-node-api-svc/otel,avenra-runtime-node-api-svc/datadog \
      -F avenra-runtime-node-api-svc/k8s \
      -F avenra-runtime-internal-api-svc/otel,avenra-runtime-internal-api-svc/datadog \
      -F avenra-runtime-internal-api-svc/k8s \
      -F avenra-runtime-node-ctl-svc/otel,avenra-runtime-node-ctl-svc/datadog \
      -F avenra-runtime-node-ctl-svc/kubernetes \
      -F avenra-runtime-node-mgr-svc/otel,avenra-runtime-node-mgr-svc/datadog \
      -F avenra-runtime-build-mgr-svc/otel,avenra-runtime-build-mgr-svc/datadog \
