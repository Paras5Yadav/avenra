      -F avenra-runtime-template-mgr/test-hooks,avenra-runtime-internal-api-server/test-hooks,avenra-runtime-credmgr/test-hooks \
      -F avenra-runtime-common-svc/test-hooks,avenra-runtime-avenrad-guest-server/test-hooks,avenra-runtime-observability/test-hooks \
      -F avenra-runtime-cluster-controller-server/test-hooks,avenra-runtime-common-core/test-hooks,avenra-runtime-sbx-mgr/test-hooks,avenra-runtime-api/test-hooks \
      -F avenra-runtime-build-mgr-server/test-hooks,avenra-runtime-node-api-server/test-hooks,avenra-runtime-node-mgr/test-hooks \
      --bin avenrad \
      --bin avenrad-svc \
      --bin avenra-buildmgr \
      --bin avenra-buildmgr-svc \
